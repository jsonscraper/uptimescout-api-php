{
  "name": "jsonscraper/uptimescout-api-php",
  "description": "UptimeScout API client for regional service availability, observation history and localized service metadata",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
