    "monitoring",
    "sdk"
  ],
  "homepage": "https://uptimescout.com",
  "support": {
    "issues": "https://github.com/jsonscraper/uptimescout-api-php/issues",
    "source": "https://github.com/jsonscraper/uptimescout-api-php",
    "docs": "https://github.com/jsonscraper/uptimescout-api-php/blob/main/docs/guide.md"
  }
